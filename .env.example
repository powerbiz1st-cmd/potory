# 이 파일을 .env 로 복사해서 값을 채우세요 (.env 는 git에 올라가지 않음)
POSTGRES_PASSWORD=potory_dev
# 관리자 화면 API 비밀번호 (8자 이상, 아무 랜덤 문자열)
ADMIN_TOKEN=change-me-to-random-string
# 배포 시 허용할 화면 주소들 (콤마 구분). 비우면 개발용으로 모두 허용
CORS_ORIGINS=
# Shop이 부를 API 주소. 비우면 "접속한 주소:3000"
VITE_API_URL=

# ---- 장애 알림 메일 (watchdog) ----
# 비워 두면 가짜 메일함 Mailpit(http://localhost:8025)으로 보냄 → 테스트용
# Gmail 예: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=보내는주소@gmail.com,
#           SMTP_PASS=구글 "앱 비밀번호" 16자리 (2단계 인증을 켠 뒤 발급)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# 보내는 사람 주소 (비우면 SMTP_USER)
ALERT_FROM=
# 알림 받을 주소 (여러 명이면 콤마로)
ALERT_TO=
# 몇 초마다 확인할지
CHECK_INTERVAL_SEC=5

# ---- DB 백업 ----
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=7

# ---- 장애 시연 (운영 콘솔 버튼) ----
# true 면 콘솔에서 응답 지연·DB 장애·서버 다운 등을 일부러 일으킬 수 있음. 실제 배포에선 false
CHAOS_ENABLED=false
